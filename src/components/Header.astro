---
import { POST_TYPES, POST_TYPE_LABEL } from '../lib/postType';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(base, '') || '/';

const menu = [
  { href: `${base}/about`, label: 'about', match: '/about' },
  ...POST_TYPES.map((t) => ({ href: `${base}/type/${t}`, label: POST_TYPE_LABEL[t], match: `/type/${t}` })),
];
---

<header class="header">
  <div class="topbar">
    <div class="container topbar__inner">
      <span class="topbar__tagline">SHARING TEA, SHARING MOMENTS</span>
      <button class="topbar__search" type="button" aria-label="검색" disabled>SEARCH ⌕</button>
    </div>
  </div>
  <div class="nav">
    <div class="container nav__inner">
      <a class="nav__logo" href={base}>TEA for ME</a>
      <nav class="nav__menu">
        {menu.map((item) => (
          <a href={item.href} class:list={['nav__link', { 'is-active': path.startsWith(item.match) }]}>{item.label}</a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  .topbar {
    display: none;
  }

  .topbar__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topbar__tagline {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--coral-tint);
  }

  .topbar__search {
    background: none;
    border: none;
    font-family: var(--font-ui);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--text-meta);
    cursor: default;
    padding: 0;
  }

  .nav {
    background: var(--ink);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 46px;
  }

  .nav__logo {
    font-family: var(--font-en);
    font-style: italic;
    font-size: 16px;
    color: var(--coral-tint);
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: 26px;
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #d5d0c7;
  }

  .nav__link.is-active {
    color: var(--coral);
    border-bottom: 2px solid var(--coral);
    padding-bottom: 2px;
  }

  .nav__link:hover {
    color: var(--coral);
  }

  @media (max-width: 480px) {
    .topbar__tagline {
      font-size: 9px;
    }

    .nav__menu {
      gap: 14px;
    }
  }
</style>
