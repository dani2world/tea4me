---
import { getCollection } from 'astro:content';
import { getKSTDateString, pickTodayTea, formatDisplayDate } from '../lib/todayTea';

const entries = await getCollection('teas', ({ data }) => !data.draft);
const catalog = entries.map((e) => e.data);
const todayStr = getKSTDateString();
const pick = pickTodayTea(catalog, todayStr);

// 클라이언트 보정 스크립트가 재계산에 쓸 원본 데이터. </script> 이스케이프로
// 문구 안에 우연히 "</script"가 섞여도 안전하게.
const catalogJson = JSON.stringify(catalog).replace(/</g, '\\u003c');
---

{pick && (
  <div class="today-tea" data-server-date={todayStr}>
    <p class="today-tea__label">
      <span class="today-tea__leaf">🍃</span> <span data-field="date">{formatDisplayDate(todayStr)}</span> 오늘의 차
    </p>
    <p class="today-tea__name" data-field="name">{pick.tea.name}</p>
    <p class="today-tea__intro" data-field="intro">{pick.intro}</p>
    <p class="today-tea__line" data-field="line">🌷 {pick.line}</p>
  </div>
)}

<script type="application/json" id="tea-catalog-data" set:html={catalogJson} />

<script type="module">
  import { getKSTDateString, pickTodayTea, formatDisplayDate } from '../lib/todayTea';

  const root = document.querySelector('.today-tea');
  if (root) {
    const serverDate = root.dataset.serverDate;
    const clientDate = getKSTDateString();
    // 대부분의 방문은 빌드 당일이라 여기서 끝 — 깜빡임 없음.
    if (clientDate !== serverDate) {
      const dataEl = document.getElementById('tea-catalog-data');
      const catalog = JSON.parse(dataEl.textContent);
      const pick = pickTodayTea(catalog, clientDate);
      if (pick) {
        root.querySelector('[data-field="date"]').textContent = formatDisplayDate(clientDate);
        root.querySelector('[data-field="name"]').textContent = pick.tea.name;
        root.querySelector('[data-field="intro"]').textContent = pick.intro;
        root.querySelector('[data-field="line"]').textContent = `🌷 ${pick.line}`;
        root.dataset.serverDate = clientDate;
      }
    }
  }
</script>

<style>
  .today-tea {
    background: var(--card-bg);
    border-radius: 12px;
    box-shadow: 0 8px 20px var(--shadow);
    padding: 22px 24px;
    width: 100%;
    max-width: 320px;
    height: 246px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    animation:
      today-tea-in 0.6s ease-out,
      today-tea-shimmer 5s ease-in-out 0.6s infinite;
  }

  @keyframes today-tea-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes today-tea-shimmer {
    0%,
    100% {
      box-shadow: 0 6px 14px var(--shadow);
    }
    50% {
      box-shadow: 0 18px 40px var(--shadow);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .today-tea,
    .today-tea__leaf {
      animation: none;
    }
  }

  .today-tea__label {
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .today-tea__leaf {
    display: inline-block;
    animation: today-tea-leaf-float 3s ease-in-out infinite;
  }

  @keyframes today-tea-leaf-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-3px) rotate(-6deg);
    }
  }

  .today-tea__name {
    font-size: 22px;
    font-weight: 800;
  }

  .today-tea__intro {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
  }

  .today-tea__line {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-muted);
  }
</style>
