---
import { getCollection } from 'astro:content';
import { getKSTDateString, pickTodayTea, formatMonoDate } from '../lib/todayTea';

const entries = await getCollection('teas', ({ data }) => !data.draft);
const catalog = entries.map((e) => e.data);
const todayStr = getKSTDateString();
const pick = pickTodayTea(catalog, todayStr);

// 클라이언트 보정 스크립트가 재계산에 쓸 원본 데이터. </script> 이스케이프로
// 문구 안에 우연히 "</script"가 섞여도 안전하게.
const catalogJson = JSON.stringify(catalog).replace(/</g, '\\u003c');
---

{pick && (
  <article class="tea" data-server-date={todayStr}>
    <div class="tea__glow" aria-hidden="true"></div>

    <div class="tea__top">
      <p class="tea__label">🍃 오늘의 차</p>
      <p class="tea__date" data-field="date">{formatMonoDate(todayStr)}</p>
    </div>

    <h2 class="tea__name" data-field="name">{pick.name}</h2>

    <div class="tea__rule" aria-hidden="true"><span class="tea__rule-fill"></span></div>

    <p class="tea__message" data-field="message">{pick.message}</p>

    <dl class="tea__specs">
      <div class="tea__spec">
        <dt>Brewing Tip</dt>
        <dd data-field="brewingTip">{pick.brewingTip}</dd>
      </div>
      <div class="tea__spec">
        <dt>Linger with</dt>
        <dd data-field="pairing">{pick.pairing}</dd>
      </div>
    </dl>

    <p class="tea__moment">
      <span aria-hidden="true">🌷</span> <span data-field="moment">{pick.moment}</span>
    </p>
  </article>
)}

<script type="application/json" id="tea-catalog-data" set:html={catalogJson} />

<script>
  import { getKSTDateString, pickTodayTea, formatMonoDate } from '../lib/todayTea';

  const root = document.querySelector<HTMLElement>('.tea');
  if (root) {
    const serverDate = root.dataset.serverDate;
    const clientDate = getKSTDateString();
    // 대부분의 방문은 빌드 당일이라 여기서 끝 — 깜빡임 없음.
    if (clientDate !== serverDate) {
      const dataEl = document.getElementById('tea-catalog-data');
      const catalog = JSON.parse(dataEl!.textContent!);
      const pick = pickTodayTea(catalog, clientDate);
      if (pick) {
        const set = (field: string, value: string) => {
          const el = root.querySelector(`[data-field="${field}"]`);
          if (el) el.textContent = value;
        };
        set('date', formatMonoDate(clientDate));
        set('name', pick.name);
        set('message', pick.message);
        set('brewingTip', pick.brewingTip);
        set('pairing', pick.pairing);
        set('moment', pick.moment);
        root.dataset.serverDate = clientDate;
      }
    }
  }
</script>

<style>
  .tea {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    padding: 26px 28px 28px;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .tea__glow {
    position: absolute;
    top: -110px;
    right: -110px;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(193, 93, 104, 0.32), transparent 70%);
    animation: coral-glow 11s ease-in-out infinite;
    pointer-events: none;
  }

  .tea > *:not(.tea__glow) {
    position: relative;
  }

  .tea__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    animation: fade-up-stagger 1s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }

  .tea__label {
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--coral-tint);
  }

  .tea__date {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .tea__name {
    font-family: var(--font-kr);
    font-weight: 400;
    font-size: 36px;
    line-height: 1.15;
    margin-top: 14px;
    text-wrap: balance;
    animation: fade-up-stagger 1s 0.15s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }

  .tea__rule {
    height: 2px;
    background: var(--dark-line-1);
    margin: 18px 0 16px;
  }

  .tea__rule-fill {
    display: block;
    height: 100%;
    background: var(--coral);
    animation: steep-bar 9s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .tea__message {
    font-family: var(--font-kr);
    font-weight: 300;
    font-size: 13px;
    line-height: 1.85;
    color: #d5d0c7;
    text-wrap: pretty;
    animation: fade-up-stagger 1s 0.3s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }

  .tea__specs {
    margin: 16px 0 0;
    display: grid;
    gap: 9px;
  }

  .tea__spec {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 1px dotted var(--dark-line-3);
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .tea__spec dt {
    color: var(--text-meta);
  }

  .tea__spec dd {
    margin: 0;
    color: #fff;
  }

  .tea__moment {
    margin-top: 16px;
    padding-top: 16px;
    font-family: var(--font-kr);
    font-weight: 300;
    font-size: 13.5px;
    color: var(--coral-tint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    animation: quote-breathe 7s ease-in-out infinite;
  }

  @media (max-width: 720px) {
    .tea__moment {
      white-space: normal;
    }
  }
</style>
