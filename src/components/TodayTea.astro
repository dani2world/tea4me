---
import { getCollection } from 'astro:content';
import { getKSTDateString, pickTodayTea, formatDisplayDate } from '../lib/todayTea';

const entries = await getCollection('teas', ({ data }) => !data.draft);
const catalog = entries.map((e) => e.data);
const todayStr = getKSTDateString();
const pick = pickTodayTea(catalog, todayStr);

// 클라이언트 보정 스크립트가 재계산에 쓸 원본 데이터. </script> 이스케이프로
// 문구 안에 우연히 "</script"가 섞여도 안전하게.
const catalogJson = JSON.stringify(catalog).replace(/</g, '\\u003c');
---

{pick && (
  <article class="tea" data-server-date={todayStr}>
    <p class="tea__label">
      <span class="tea__leaf" aria-hidden="true">🍃</span>
      <span>오늘의 차</span>
      <span class="tea__date" data-field="date">{formatDisplayDate(todayStr)}</span>
    </p>

    <h2 class="tea__name" data-field="name">{pick.name}</h2>
    <p class="tea__message" data-field="message">{pick.message}</p>

    <dl class="tea__specs">
      <div class="tea__spec">
        <dt>Brewing Tip</dt>
        <dd class="tea__spec-value tea__spec-value--num" data-field="brewingTip">{pick.brewingTip}</dd>
      </div>
      <div class="tea__spec">
        <dt>Linger with</dt>
        <dd class="tea__spec-value" data-field="pairing">{pick.pairing}</dd>
      </div>
    </dl>

    <p class="tea__moment">
      <span class="tea__moment-flower" aria-hidden="true">🌷</span>
      <span class="tea__moment-text" data-field="moment">{pick.moment}</span>
    </p>
  </article>
)}

<script type="application/json" id="tea-catalog-data" set:html={catalogJson} />

<script>
  import { getKSTDateString, pickTodayTea, formatDisplayDate } from '../lib/todayTea';

  const root = document.querySelector<HTMLElement>('.tea');
  if (root) {
    const serverDate = root.dataset.serverDate;
    const clientDate = getKSTDateString();
    // 대부분의 방문은 빌드 당일이라 여기서 끝 — 깜빡임 없음.
    if (clientDate !== serverDate) {
      const dataEl = document.getElementById('tea-catalog-data');
      const catalog = JSON.parse(dataEl!.textContent!);
      const pick = pickTodayTea(catalog, clientDate);
      if (pick) {
        const set = (field: string, value: string) => {
          const el = root.querySelector(`[data-field="${field}"]`);
          if (el) el.textContent = value;
        };
        set('date', formatDisplayDate(clientDate));
        set('name', pick.name);
        set('message', pick.message);
        set('brewingTip', pick.brewingTip);
        set('pairing', pick.pairing);
        set('moment', pick.moment);
        root.dataset.serverDate = clientDate;
      }
    }
  }
</script>

<style>
  .tea {
    --tea-rule: color-mix(in srgb, var(--sage) 34%, transparent);

    position: relative;
    overflow: hidden;
    background: var(--card-bg);
    border-radius: 14px;
    box-shadow: 0 10px 30px -12px var(--shadow);
    padding: 26px 26px 24px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 18px;
    animation: tea-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* 우려낸 찻물이 위쪽에 옅게 배어 있는 느낌 — 카드를 나누지 않고 결만 준다. */
  .tea::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 140px;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--sage) 13%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .tea > * {
    position: relative;
  }

  /* 진입은 한 번만, 안쪽 요소가 순서대로 따라 들어온다. */
  @keyframes tea-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .tea__label,
  .tea__name,
  .tea__message,
  .tea__specs,
  .tea__moment {
    animation: tea-settle 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .tea__label { animation-delay: 0.08s; }
  .tea__name { animation-delay: 0.16s; }
  .tea__message { animation-delay: 0.24s; }
  .tea__specs { animation-delay: 0.32s; }
  .tea__moment { animation-delay: 0.4s; }

  @keyframes tea-settle {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .tea__label {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent-text);
  }

  .tea__date {
    margin-left: auto;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .tea__leaf {
    display: inline-block;
    font-size: 13px;
    animation: tea-leaf 6s ease-in-out infinite;
  }

  @keyframes tea-leaf {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-2px) rotate(-7deg); }
  }

  .tea__name {
    font-size: clamp(26px, 3.4vw, 31px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-wrap: balance;
    margin-top: -4px;
  }

  .tea__message {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .tea__specs {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-top: 17px;
    border-top: 1px solid var(--tea-rule);
  }

  .tea__spec {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .tea__spec dt {
    flex: 0 0 84px;
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--sage-label);
  }

  .tea__spec-value {
    margin: 0;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text);
  }

  .tea__spec-value--num {
    font-variant-numeric: tabular-nums;
  }

  /* 라벨 없이 한 줄로 맺는 자리 — 꽃 글리프를 들여쓰기 기준으로 삼아
     두 줄로 넘어가도 문장이 글리프 아래로 흘러들지 않게 한다. */
  .tea__moment {
    display: flex;
    align-items: baseline;
    gap: 7px;
    padding-top: 16px;
    border-top: 1px solid var(--tea-rule);
  }

  .tea__moment-flower {
    flex: none;
    font-size: 13px;
  }

  .tea__moment-text {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--accent-text);
    text-wrap: pretty;
  }

  .tea ::selection {
    background: color-mix(in srgb, var(--sage) 34%, transparent);
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .tea,
    .tea__label,
    .tea__name,
    .tea__message,
    .tea__specs,
    .tea__moment,
    .tea__leaf {
      animation: none;
    }
  }
</style>
