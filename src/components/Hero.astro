---
const base = import.meta.env.BASE_URL;
import TodayTea from './TodayTea.astro';
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="hero__label">🫖Sharing tea, sharing moments</p>
      <h1 class="hero__title">차 한잔에서 시작되는<br />작은 순간들</h1>
      <p class="hero__desc">차에 관한 이야기와 직접 마셔본 차의 기록,<br />그리고 차를 마시며 만난 순간들을 담습니다.</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#latest">최근 글 보기</a>
        <a class="btn btn--ghost" href={`${base}/about`}>소개</a>
      </div>
    </div>
    <div class="hero__tea-slot">
      <TodayTea />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 96px 0 64px;
  }

  .hero__grid {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 48px;
  }

  .hero__text {
    flex: 1 1 480px;
  }

  .hero__tea-slot {
    flex: 0 0 358px;
  }

  @media (max-width: 900px) {
    .hero__grid {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__tea-slot {
      flex-basis: auto;
      align-self: stretch;
    }
  }

  .hero__label {
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 18px;
  }

  .hero__title {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.25;
    margin-bottom: 20px;
  }

  .hero__desc {
    font-size: 18px;
    color: var(--text-muted);
    margin-bottom: 32px;
    max-width: 480px;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
  }
</style>
