---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { POST_TYPE_LABEL } from '../lib/postType';

interface Props {
  post: CollectionEntry<'posts'>;
  variant?: 'default' | 'latest';
}

const { post, variant = 'default' } = Astro.props;
const { data } = post;
const base = import.meta.env.BASE_URL;
const dateLabel = new Intl.DateTimeFormat('ko-KR', { month: '2-digit', day: '2-digit' })
  .format(data.pubDate)
  .replace(/\./g, '.')
  .replace(/\s/g, '');
const focal = data.coverImageFocalPoint;
---

{variant === 'latest' ? (
  <a class="post-card post-card--latest" href={`${base}/posts/${post.id}`}>
    {data.titleBreak ? (
      <h3 class="post-card__title post-card__title--latest" set:html={data.titleBreak} />
    ) : (
      <h3 class="post-card__title post-card__title--latest">{data.title}</h3>
    )}
    <div class="post-card__thumb">
      <span class="badge-latest">LATEST</span>
      <Image
        src={data.coverImage}
        alt={data.coverImageAlt}
        width={820}
        style={`object-position: ${focal.x * 100}% ${focal.y * 100}%`}
      />
    </div>
    <p class="post-card__excerpt" set:html={data.excerpt} />
    <span class="post-card__continue">CONTINUE →</span>
  </a>
) : (
  <a class="post-card post-card--default" href={`${base}/posts/${post.id}`}>
    <div class="post-card__thumb">
      <Image
        src={data.coverImage}
        alt={data.coverImageAlt}
        width={480}
        style={`object-position: ${focal.x * 100}% ${focal.y * 100}%`}
      />
    </div>
    <div class="post-card__body">
      <div class="post-card__meta">
        <span class="tag">{POST_TYPE_LABEL[data.type]}</span>
        <span class="post-card__date">{dateLabel}</span>
      </div>
      <h3 class="post-card__title">{data.title}</h3>
      <p class="post-card__excerpt" set:html={data.excerpt} />
    </div>
  </a>
)}

<style>
  .post-card {
    display: block;
    background: #fff;
    border: 1px solid var(--border-soft);
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .post-card--default {
    /* 카드 전체(사진+본문)를 1:1로 — 각 행의 카드 폭이 같으므로 이것만으로 행 안 높이도 자동으로 맞는다 */
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
  }

  .post-card--default .post-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .post-card--default .post-card__title {
    /* 제목이 1줄이든 2줄이든 본문 영역 안에서 흔들리지 않게 자리를 미리 확보 */
    font-weight: 600;
    min-height: 2.8em;
    margin-bottom: 8px;
  }

  .post-card--default .post-card__thumb {
    /* 카드 높이의 절반 남짓만 사진이 차지하고, 나머지는 본문에 남긴다 */
    flex: 0 0 52%;
    height: auto;
  }

  .post-card--default .post-card__excerpt {
    font-family: var(--font-kr);
    font-weight: 300;
    font-size: 13px;
    line-height: 1.75;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card:hover {
    border-color: var(--coral);
    box-shadow: 0 10px 26px rgba(18, 17, 16, 0.16);
  }

  .post-card__thumb {
    position: relative;
    height: 118px;
    overflow: hidden;
    background: var(--border-soft);
  }

  .post-card__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .post-card:hover .post-card__thumb :global(img) {
    transform: scale(1.09);
  }

  .post-card__body {
    padding: 13px 15px 17px;
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .post-card__date {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--text-meta);
  }

  .post-card__title {
    font-family: var(--font-kr);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.4;
    text-wrap: pretty;
  }

  /* ---------- latest variant ---------- */

  .post-card--latest {
    background: var(--paper);
    border: none;
    display: flex;
    flex-direction: column;
  }

  .post-card--latest:hover {
    box-shadow: none;
  }

  .post-card--latest .post-card__thumb {
    height: 134px;
    margin-top: 16px;
  }

  .post-card--latest .post-card__title--latest {
    font-family: var(--font-kr);
    font-weight: 600;
    font-size: 38px;
    line-height: 1.16;
    letter-spacing: -0.02em;
  }

  .post-card--latest .post-card__title--latest :global(em) {
    font-family: var(--font-en), var(--font-kr);
    font-style: italic;
    color: var(--coral);
  }

  .post-card--latest .post-card__excerpt {
    font-family: var(--font-kr);
    font-weight: 300;
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--text-secondary);
    margin-top: 14px;
  }

  .post-card--latest .post-card__continue {
    display: block;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.06em;
    white-space: nowrap;
    border-bottom: 2px solid var(--coral);
    padding-bottom: 3px;
    align-self: flex-end;
    margin-top: 0;
  }

  @media (max-width: 720px) {
    .post-card--latest .post-card__thumb {
      height: 150px;
    }

    .post-card--latest .post-card__title--latest {
      font-size: 26px;
      line-height: 1.2;
    }

    .post-card .post-card__title {
      font-size: 13.5px;
      line-height: 1.45;
    }

    .post-card .post-card__body {
      padding: 9px 10px 12px;
    }
  }
</style>
