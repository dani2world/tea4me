---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { QUESTIONS, RESULTS } from '../data/findYourCup';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const relatedByResult = RESULTS.map((result) => ({
  result,
  posts: allPosts.filter((p) => p.data.category === result.category).slice(0, 3),
}));
---

<BaseLayout title="차 취향 찾기 · TEA for ME" description="다섯 가지 질문으로 오늘의 기분에 맞는 한 잔을 골라드려요.">
  <section class="quiz" data-quiz>
    <div class="quiz__glow" aria-hidden="true"></div>

    <div class="container quiz__inner">
      <!-- 시작 화면 -->
      <div class="quiz__screen is-active" data-screen="start">
        <p class="quiz__eyebrow">차 취향 찾기</p>
        <h1 class="quiz__start-title">당신의 차 취향은<br />어느 쪽인가요?</h1>
        <p class="quiz__start-desc">다섯 가지 질문이면 충분해요.<br />오늘의 기분과 온도에 맞는 한 잔을 골라드립니다.</p>
        <button type="button" class="btn btn--primary" data-start>START →</button>
        <p class="quiz__start-time">약 40초</p>
      </div>

      <!-- 질문 화면 -->
      {QUESTIONS.map((q, i) => (
        <div class="quiz__screen" data-screen="question" data-question-index={i}>
          <div class="quiz__progress">
            <div class="quiz__dots">
              {QUESTIONS.map((_, dotIndex) => (
                <span class="quiz__dot" data-dot={dotIndex}></span>
              ))}
            </div>
            <span class="quiz__count">{String(i + 1).padStart(2, '0')} / {String(QUESTIONS.length).padStart(2, '0')}</span>
          </div>
          <p class="quiz__axis">{q.axisLabel}</p>
          <h2 class="quiz__question" set:html={q.question} />
          <div class="quiz__options" data-options>
            {q.options.map((opt) => (
              <button type="button" class="quiz__option" data-option-id={opt.id}>
                <span class="quiz__option-text">{opt.text}</span>
                <span class="quiz__option-sub">{opt.sub}</span>
              </button>
            ))}
          </div>
          <div class="quiz__nav">
            <button type="button" class="quiz__nav-btn quiz__nav-btn--prev" data-prev>← 이전 질문</button>
            <button type="button" class="quiz__nav-btn quiz__nav-btn--next" data-next disabled>NEXT →</button>
          </div>
        </div>
      ))}

      <!-- 결과 화면 -->
      <div class="quiz__screen" data-screen="result">
        {relatedByResult.map(({ result, posts }) => (
          <div class="result-panel" data-result-id={result.id} hidden>
            <div class="result-card">
              <div class="result-card__glow" aria-hidden="true"></div>
              <div class="result-card__top">
                <p class="result-card__label">당신에게 어울리는 한 잔</p>
                <span class="result-card__tag">RESULT</span>
              </div>
              <div class="result-card__grid">
                <div>
                  <h2 class="result-card__name">{result.name}</h2>
                  <div class="result-card__rule" aria-hidden="true"><span></span></div>
                  <p class="result-card__desc">{result.desc}</p>
                  <p class="result-card__quote">"{result.quote}"</p>
                </div>
                <div class="result-card__specs">
                  <dl>
                    <div><dt>Brewing Tip</dt><dd>{result.temp} · {result.time}</dd></div>
                    <div><dt>Leaf</dt><dd>{result.leaf}</dd></div>
                    <div><dt>Linger with</dt><dd>{result.pairing}</dd></div>
                    <div><dt>Type</dt><dd>{result.category}</dd></div>
                  </dl>
                  <div class="result-card__actions">
                    <button type="button" class="btn btn--primary" data-share-result={result.id}>공유하기</button>
                    <button type="button" class="btn btn--ghost result-card__retry" data-restart>다시 하기</button>
                  </div>
                </div>
              </div>
            </div>

            {posts.length > 0 && (
              <div class="result-related">
                <p class="result-related__title">함께 읽어보세요 <span>{posts.length} ARTICLES</span></p>
                <div class="result-related__grid">
                  {posts.map((post) => <PostCard post={post} />)}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { QUESTIONS, scoreAnswers } from '../data/findYourCup';

  const root = document.querySelector<HTMLElement>('[data-quiz]');
  if (root) {
    const screens = {
      start: root.querySelector<HTMLElement>('[data-screen="start"]')!,
      questions: Array.from(root.querySelectorAll<HTMLElement>('[data-screen="question"]')),
      result: root.querySelector<HTMLElement>('[data-screen="result"]')!,
    };
    const answers: Record<number, string> = {};

    const showScreen = (el: HTMLElement) => {
      root.querySelectorAll('[data-screen]').forEach((s) => s.classList.remove('is-active'));
      el.classList.add('is-active');
      window.scrollTo({ top: root.offsetTop - 20, behavior: 'smooth' });
    };

    const showResult = (resultId: string) => {
      root.querySelectorAll<HTMLElement>('[data-result-id]').forEach((panel) => {
        panel.hidden = panel.dataset.resultId !== resultId;
      });
      showScreen(screens.result);
    };

    // URL 쿼리로 공유된 결과 바로 보여주기.
    const shared = new URLSearchParams(window.location.search).get('r');
    if (shared && root.querySelector(`[data-result-id="${shared}"]`)) {
      showResult(shared);
    }

    root.querySelector('[data-start]')?.addEventListener('click', () => showScreen(screens.questions[0]));

    screens.questions.forEach((screen, index) => {
      const options = Array.from(screen.querySelectorAll<HTMLButtonElement>('[data-option-id]'));
      const nextBtn = screen.querySelector<HTMLButtonElement>('[data-next]')!;
      const prevBtn = screen.querySelector<HTMLButtonElement>('[data-prev]')!;
      const dots = screen.querySelectorAll<HTMLElement>('[data-dot]');

      dots.forEach((dot, i) => dot.classList.toggle('is-current', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-done', i < index));

      options.forEach((opt) => {
        opt.addEventListener('click', () => {
          options.forEach((o) => o.classList.toggle('is-selected', o === opt));
          answers[index] = opt.dataset.optionId!;
          nextBtn.disabled = false;
        });
      });

      prevBtn.style.visibility = index === 0 ? 'hidden' : 'visible';
      prevBtn.addEventListener('click', () => showScreen(index === 0 ? screens.start : screens.questions[index - 1]));

      nextBtn.addEventListener('click', () => {
        if (index < screens.questions.length - 1) {
          showScreen(screens.questions[index + 1]);
        } else {
          const resultId = scoreAnswers(Object.values(answers));
          showResult(resultId);
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-restart]').forEach((btn) => {
      btn.addEventListener('click', () => {
        Object.keys(answers).forEach((k) => delete answers[Number(k)]);
        screens.questions.forEach((s) => {
          s.querySelectorAll('[data-option-id]').forEach((o) => o.classList.remove('is-selected'));
          s.querySelector<HTMLButtonElement>('[data-next]')!.disabled = true;
        });
        showScreen(screens.start);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-share-result]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.shareResult!;
        const url = new URL(window.location.href);
        url.searchParams.set('r', id);
        try {
          await navigator.clipboard.writeText(url.toString());
          const original = btn.textContent;
          btn.textContent = '링크 복사됨';
          setTimeout(() => (btn.textContent = original), 1600);
        } catch {
          // 클립보드 API 미지원 — 조용히 무시.
        }
      });
    });
  }
</script>

<style>
  .quiz {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
  }

  .quiz__glow {
    position: absolute;
    top: -140px;
    right: -140px;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(193, 93, 104, 0.28), transparent 70%);
    animation: coral-glow 11s ease-in-out infinite;
    pointer-events: none;
  }

  .quiz__inner {
    position: relative;
    padding: 0 60px;
  }

  .quiz__screen {
    display: none;
    min-height: 400px;
    padding: 64px 0;
  }

  .quiz__screen.is-active {
    display: block;
  }

  /* 시작 화면 */
  .quiz__screen[data-screen='start'] {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    display: none;
  }

  .quiz__screen[data-screen='start'].is-active {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .quiz__eyebrow {
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--coral-tint);
    margin-bottom: 20px;
  }

  .quiz__start-title {
    font-family: var(--font-kr);
    font-weight: 400;
    font-size: clamp(28px, 4.4vw, 44px);
    line-height: 1.25;
    margin-bottom: 24px;
  }

  .quiz__start-desc {
    font-family: var(--font-kr);
    font-weight: 300;
    font-size: 14px;
    line-height: 1.8;
    color: #d5d0c7;
    margin-bottom: 32px;
  }

  .quiz__start-time {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-meta);
  }

  /* 질문 화면 */
  .quiz__screen[data-screen='question'] {
    max-width: 620px;
    margin: 0 auto;
  }

  .quiz__progress {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
  }

  .quiz__dots {
    display: flex;
    gap: 7px;
  }

  .quiz__dot {
    width: 22px;
    height: 3px;
    background: var(--dark-line-1);
  }

  .quiz__dot.is-done,
  .quiz__dot.is-current {
    background: var(--coral);
  }

  .quiz__count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-meta);
  }

  .quiz__axis {
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--coral-tint);
    margin-bottom: 16px;
  }

  .quiz__question {
    font-family: var(--font-kr);
    font-weight: 400;
    font-size: clamp(22px, 3.4vw, 34px);
    line-height: 1.35;
    margin-bottom: 34px;
  }

  .quiz__options {
    display: grid;
    gap: 12px;
    margin-bottom: 40px;
  }

  .quiz__option {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    background: none;
    border: 1px solid var(--dark-line-3);
    padding: 20px 22px;
    text-align: left;
    color: #fff;
    cursor: pointer;
  }

  .quiz__option:hover {
    border-color: var(--dark-line-2);
  }

  .quiz__option.is-selected {
    border-color: var(--coral);
    background: rgba(193, 93, 104, 0.12);
  }

  .quiz__option-text {
    font-family: var(--font-kr);
    font-size: 16px;
  }

  .quiz__option-sub {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--text-meta);
    white-space: nowrap;
  }

  .quiz__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .quiz__nav-btn {
    background: none;
    border: none;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    min-height: 44px;
  }

  .quiz__nav-btn--prev {
    color: var(--text-meta);
  }

  .quiz__nav-btn--next {
    color: var(--coral);
    border-bottom: 2px solid var(--coral);
    padding-bottom: 2px;
  }

  .quiz__nav-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* 결과 화면 */
  .quiz__screen[data-screen='result'] {
    padding-top: 40px;
  }

  .result-card {
    position: relative;
    overflow: hidden;
    padding: 30px;
  }

  .result-card__glow {
    position: absolute;
    top: -110px;
    right: -110px;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(193, 93, 104, 0.32), transparent 70%);
    animation: coral-glow 11s ease-in-out infinite;
    pointer-events: none;
  }

  .result-card__top {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 26px;
  }

  .result-card__label {
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--coral-tint);
  }

  .result-card__tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-meta);
  }

  .result-card__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
  }

  .result-card__name {
    font-family: var(--font-kr);
    font-weight: 400;
    font-size: 46px;
    margin-bottom: 18px;
  }

  .result-card__rule {
    height: 2px;
    background: var(--dark-line-1);
    max-width: 200px;
    margin-bottom: 18px;
  }

  .result-card__rule span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--coral);
    animation: steep-bar 9s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .result-card__desc {
    font-family: var(--font-kr);
    font-weight: 300;
    font-size: 14px;
    line-height: 1.95;
    color: #d5d0c7;
    margin-bottom: 16px;
  }

  .result-card__quote {
    font-family: var(--font-kr);
    font-weight: 300;
    font-style: italic;
    font-size: 14px;
    color: var(--coral-tint);
  }

  .result-card__specs dl {
    display: grid;
    gap: 10px;
    margin: 0 0 24px;
  }

  .result-card__specs > dl > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px dotted var(--dark-line-3);
    padding-bottom: 8px;
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 500;
  }

  .result-card__specs dt {
    color: var(--text-meta);
  }

  .result-card__specs dd {
    margin: 0;
  }

  .result-card__actions {
    display: flex;
    gap: 12px;
  }

  .result-card__actions .btn--ghost {
    border-color: var(--dark-line-3);
    color: #fff;
  }

  .result-related {
    background: var(--paper);
    color: var(--text-body);
    padding: 40px 30px 10px;
  }

  .result-related__title {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    display: flex;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-strong);
    margin-bottom: 24px;
  }

  .result-related__title span {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--text-meta);
  }

  .result-related__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    padding-bottom: 30px;
  }

  @media (max-width: 900px) {
    .quiz__inner {
      padding: 0 24px;
    }

    .result-card__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .result-related__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
