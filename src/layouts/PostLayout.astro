---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import AttributionBadge from '../components/AttributionBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;
const base = import.meta.env.BASE_URL;
const dateLabel = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(
  data.pubDate,
);
---

<BaseLayout title={`${data.title} · TEA for ME`} description={data.excerpt}>
  <article class="post container">
    <div class="post__meta">
      <span class={`tag ${data.type === 'experience' ? 'tag--experience' : 'tag--info'}`}>
        {data.type === 'experience' ? '경험' : '정보'}
      </span>
      <a class="post__category" href={`${base}/category/${data.category}`}>{data.category}</a>
      <span class="post__date">{dateLabel}</span>
    </div>
    <h1 class="post__title">{data.title}</h1>
    <div class="post__cover">
      <Image src={data.coverImage} alt={data.coverImageAlt} width={960} />
      {data.coverImageAttribution && <AttributionBadge {...data.coverImageAttribution} />}
    </div>
    <div class="post__content">
      <slot />
    </div>
    {data.keyTakeaways && data.keyTakeaways.length > 0 && (
      <div class="post__summary">
        <p class="post__summary-label">Summary</p>
        <ul>
          {data.keyTakeaways.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
    )}
    {data.humanNote && <blockquote class="post__note">"{data.humanNote}"</blockquote>}
    {data.tags.length > 0 && (
      <ul class="post__tags">
        {data.tags.map((tag) => (
          <li><a href={`${base}/tags/${tag}`}>#{tag}</a></li>
        ))}
      </ul>
    )}
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    padding-top: 56px;
    padding-bottom: 80px;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .post__category,
  .post__date {
    font-size: 13px;
    color: var(--text-muted);
  }

  .post__category:hover {
    color: var(--accent);
  }

  .post__tags a:hover {
    color: var(--accent);
  }

  .post__title {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.3;
    margin-bottom: 28px;
  }

  .post__cover {
    margin-bottom: 40px;
  }

  .post__cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .post__content {
    font-size: 17px;
    line-height: 1.9;
    letter-spacing: -0.003em;
  }

  .post__content :global(p) {
    margin-bottom: 1.4em;
  }

  .post__content :global(h2) {
    font-size: 22px;
    margin: 2em 0 0.8em;
  }

  .post__content :global(img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-top: 0.5em;
  }

  .post__content :global(em) {
    display: block;
    font-size: 13px;
    color: var(--text-muted);
    margin-top: -0.8em;
    margin-bottom: 1.4em;
  }

  .post__content :global(strong) {
    font-weight: 700;
    color: var(--accent);
  }

  .post__content :global(u) {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .post__content :global(ul),
  .post__content :global(ol) {
    margin: 0 0 1.4em;
    padding-left: 22px;
  }

  .post__content :global(li) {
    margin-bottom: 0.4em;
  }

  .post__summary {
    margin: 2.5em 0 3em;
    padding: 18px 22px;
    background: var(--tag-info-bg);
    border-radius: 12px;
  }

  .post__summary-label {
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tag-info-text);
    margin-bottom: 10px;
  }

  .post__summary ul {
    margin: 0;
    padding-left: 20px;
    color: var(--text);
  }

  .post__summary li {
    font-size: 15px;
    line-height: 1.7;
  }

  .post__summary li + li {
    margin-top: 6px;
  }

  .post__note {
    margin: 3em 0 2.5em;
    padding-left: 20px;
    border-left: 3px solid var(--accent);
    font-style: italic;
    font-size: 20px;
    color: var(--accent);
    white-space: pre-line;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin-top: 48px;
    font-size: 13px;
    color: var(--text-muted);
  }
</style>
