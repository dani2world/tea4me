---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import AttributionBadge from '../components/AttributionBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;
const dateLabel = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(
  data.pubDate,
);
---

<BaseLayout title={`${data.title} · 차로 하루를 편집하는 사람`} description={data.excerpt}>
  <article class="post container">
    <div class="post__meta">
      <span class={`tag ${data.type === 'experience' ? 'tag--experience' : 'tag--info'}`}>
        {data.type === 'experience' ? '경험' : '정보'}
      </span>
      <span class="post__category">{data.category}</span>
      <span class="post__date">{dateLabel}</span>
    </div>
    <h1 class="post__title">{data.title}</h1>
    <div class="post__cover">
      <Image src={data.coverImage} alt={data.coverImageAlt} width={960} height={600} />
      {data.coverImageAttribution && <AttributionBadge {...data.coverImageAttribution} />}
    </div>
    <div class="post__content">
      <slot />
    </div>
    {data.tags.length > 0 && (
      <ul class="post__tags">
        {data.tags.map((tag) => (
          <li>#{tag}</li>
        ))}
      </ul>
    )}
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    padding-top: 56px;
    padding-bottom: 80px;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .post__category,
  .post__date {
    font-size: 13px;
    color: var(--text-muted);
  }

  .post__title {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.3;
    margin-bottom: 28px;
  }

  .post__cover {
    margin-bottom: 40px;
  }

  .post__cover :global(img) {
    width: 100%;
    border-radius: 12px;
  }

  .post__content {
    font-size: 17px;
    line-height: 1.9;
    letter-spacing: -0.003em;
  }

  .post__content :global(p) {
    margin-bottom: 1.4em;
  }

  .post__content :global(h2) {
    font-size: 22px;
    margin: 2em 0 0.8em;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin-top: 48px;
    font-size: 13px;
    color: var(--text-muted);
  }
</style>
